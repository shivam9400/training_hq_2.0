rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function str(v, n) { return v is string && v.size() <= n; }
    function num(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function optionalNum(v, lo, hi) { return v == null || (v is number && v >= lo && v <= hi); }
    function date(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function instant(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$'); }
    function kind(v) { return v in ['Run', 'Walk', 'Strength', 'Yoga', 'Training', 'Rest', 'Race', 'Other']; }
    function identity(d, id) { return d.id == id && id.matches('^[A-Za-z0-9_-]{1,80}$'); }
    function fields(d, names) {
      let keys = d.keys();
      return keys.size() == names.size() && keys.hasOnly(names);
    }
    function optionalFields(d, required, optional) {
      let keys = d.keys();
      return keys.hasAll(required) && keys.hasOnly(required.concat(optional));
    }
    function hash(v) { return v is string && v.matches('^[a-f0-9]{64}$'); }
    function source(v, session) {
      return v is map && v.keys().hasAll(['sourceId', 'sourceHash', 'version'])
        && v.keys().hasOnly(session ? ['sourceId', 'sourceHash', 'version', 'rowId'] : ['sourceId', 'sourceHash', 'version'])
        && hash(v.sourceId) && hash(v.sourceHash) && v.version is int && v.version == 1
        && (!session || ('rowId' in v && hash(v.rowId)));
    }
    function metadata(d) {
      return (!('slot' in d) || (d.slot is int && num(d.slot, 1, 99)))
        && (!('week' in d) || (d.week is int && num(d.week, 1, 9999)))
        && (!('phase' in d) || str(d.phase, 120))
        && (!('day' in d) || d.day in ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'])
        && (!('importSource' in d) || (d.keys().hasAll(['slot', 'week', 'phase', 'day']) && source(d.importSource, true) && d.id == 'row_' + d.importSource.rowId && d.planId == 'imp_' + d.importSource.sourceId));
    }
    function validPlan(d) {
      return optionalFields(d, ['id', 'title', 'startDate', 'endDate'], ['importSource']) && str(d.title, 120) && d.title.size() > 0 && date(d.startDate) && date(d.endDate) && d.startDate <= d.endDate && (!('importSource' in d) || (source(d.importSource, false) && d.id == 'imp_' + d.importSource.sourceId));
    }
    function validSession(d) {
      return optionalFields(d, ['id', 'planId', 'date', 'type', 'title', 'minutes', 'target', 'instructions', 'status'], ['slot', 'week', 'phase', 'day', 'importSource', 'actualWorkoutId']) && metadata(d)
        && d.planId is string && d.planId.matches('^[A-Za-z0-9_-]{1,80}$') && date(d.date) && kind(d.type)
        && str(d.title, 120) && d.title.size() > 0 && num(d.minutes, 0, 900)
        && (d.type != 'Run' || d.minutes > 0)
        && (!('actualWorkoutId' in d) || nullableId(d.actualWorkoutId))
        && str(d.target, 200) && str(d.instructions, 4000) && d.status in ['Planned', 'Done', 'Partial', 'Skipped'];
    }
    function nullableId(v) { return v == null || (v is string && v.matches('^[A-Za-z0-9_-]{1,80}$')); }
    function format(v) { return v in ['FIT','TCX','CSV','GPX','KML']; }
    function metricSources(m) {
      return m is map && fields(m,['elapsed','moving','distance','averageHr','maxHr','calories','steps','cadence','elevation'])
        && m.values().hasOnly(['FIT','TCX','CSV','GPX','KML','FIT-samples','TCX-samples','CSV-samples','GPX-samples','KML-samples','samples','timestamps','missing']);
    }
    function reportedSources(m) {
      return m is map && fields(m,['FIT','TCX','CSV','GPX','KML']) && optionalNum(m.FIT,0,500000) && optionalNum(m.TCX,0,500000) && optionalNum(m.CSV,0,500000) && optionalNum(m.GPX,0,500000) && optionalNum(m.KML,0,500000);
    }
    function details(d) {
      return d is map && fields(d,['typeSource','elapsedSeconds','reportedElapsedSeconds','movingSeconds','maxHr','calories','steps','cadence','cadenceUnit','elevationGainMeters','minElevationMeters','maxElevationMeters','elevationSampleCount','hrSampleCount','gpsSampleCount','invalidGpsCount','gpsSource','reportedByFormat','metricSources'])
        && (format(d.typeSource) || d.typeSource in ['user','missing']) && num(d.elapsedSeconds,0.001,86400) && optionalNum(d.reportedElapsedSeconds,0,86400) && optionalNum(d.movingSeconds,0,86400) && (d.movingSeconds == null || d.movingSeconds <= d.elapsedSeconds + 5)
        && optionalNum(d.maxHr,25,250) && optionalNum(d.calories,0,30000) && optionalNum(d.steps,0,200000) && optionalNum(d.cadence,0,400) && (d.cadenceUnit == null || d.cadenceUnit in ['rpm','steps/min'])
        && optionalNum(d.elevationGainMeters,0,30000) && optionalNum(d.minElevationMeters,-1000,10000) && optionalNum(d.maxElevationMeters,-1000,10000)
        && d.elevationSampleCount is int && num(d.elevationSampleCount,0,50000) && d.hrSampleCount is int && num(d.hrSampleCount,0,50000) && d.gpsSampleCount is int && num(d.gpsSampleCount,0,50000) && d.invalidGpsCount is int && num(d.invalidGpsCount,0,50000)
        && (d.gpsSource == null || format(d.gpsSource)) && reportedSources(d.reportedByFormat) && metricSources(d.metricSources);
    }
    function hashList(v) {
      let joined = v is list ? v.join(',') : '';
      // The exact joined length fixes the separator count, so embedded commas cannot
      // turn one oversized member into multiple accepted hashes. join requires strings.
      return v is list && v.size() >= 1 && v.size() <= 8
        && joined.size() == v.size() * 65 - 1
        && joined.matches('^[a-f0-9]{64}(,[a-f0-9]{64}){0,7}$');
    }
    function provenance(p) {
      return p is map && fields(p,['version','aliases','formats','summaryHash']) && p.version is int && p.version == 1 && hash(p.summaryHash)
        && hashList(p.aliases) && p.formats is list && p.formats.size() >= 1 && p.formats.size() <= 5 && p.formats.hasOnly(['FIT','TCX','CSV','GPX','KML']);
    }
    function validWorkout(d) {
      return optionalFields(d, ['id', 'title', 'type', 'start', 'end', 'reportedMeters', 'gpsMeters', 'distanceSource', 'qualityFlags', 'source', 'sourceId', 'averageHr'], ['details','provenance','matchSessionId'])
        && str(d.title, 120) && d.title.size() > 0 && kind(d.type) && instant(d.start) && instant(d.end) && d.end > d.start
        && optionalNum(d.reportedMeters, 0, 500000) && optionalNum(d.gpsMeters, 0, 500000)
        && d.distanceSource in ['reported', 'gps-validated', 'unavailable']
        && (d.distanceSource != 'reported' || d.reportedMeters != null)
        && (d.distanceSource != 'gps-validated' || (d.gpsMeters != null && d.qualityFlags.hasAny(['gps-validated'])))
        && d.qualityFlags is list && d.qualityFlags.size() <= 10
        && d.qualityFlags.hasOnly(['unvalidated-summary', 'gps-validated', 'gps-unreliable', 'distance-mismatch', 'no-distance', 'source-conflict'])
        && str(d.source, 80) && d.source.size() > 0 && str(d.sourceId, 200) && d.sourceId.size() > 0 && optionalNum(d.averageHr, 25, 250)
        && (!('details' in d) || details(d.details))
        && (!('provenance' in d) || (provenance(d.provenance) && 'details' in d && d.source == 'health-sync' && hash(d.sourceId) && d.id == 'act_' + d.sourceId))
        && (!('matchSessionId' in d) || nullableId(d.matchSessionId));
    }
    function validRace(d) {
      return fields(d, ['id', 'title', 'date', 'distanceKm', 'goal']) && str(d.title, 120) && d.title.size() > 0 && date(d.date) && num(d.distanceKm, 0.001, 500) && str(d.goal, 300);
    }
    function validMetric(d) {
      return fields(d, ['id', 'date', 'restingHr', 'hrv', 'sleepHours', 'soreness', 'rpe', 'steps', 'notes'])
        && date(d.date) && d.id == d.date && optionalNum(d.restingHr, 25, 220) && optionalNum(d.hrv, 0, 300)
        && optionalNum(d.sleepHours, 0, 24) && optionalNum(d.soreness, 1, 5) && optionalNum(d.rpe, 1, 10)
        && optionalNum(d.steps, 0, 200000) && str(d.notes, 2000);
    }
    function known(c) { return c in ['plans', 'sessions', 'workouts', 'races', 'metrics']; }
    match /users/{uid}/{collection}/{id} {
      allow get, delete: if owner(uid) && known(collection);
      allow list: if owner(uid) && known(collection) && request.query.limit != null && request.query.limit <= 200;
    }
    // Dispatch by path: do not evaluate unrelated collection validators against rich summaries.
    match /users/{uid}/plans/{id} {
      allow create, update: if owner(uid) && identity(request.resource.data, id) && validPlan(request.resource.data);
    }
    match /users/{uid}/sessions/{id} {
      allow create, update: if owner(uid) && identity(request.resource.data, id) && validSession(request.resource.data);
    }
    match /users/{uid}/workouts/{id} {
      // Imported identity is already validated as act_ + a strict 64-character source hash.
      allow create, update: if owner(uid) && request.resource.data.id == id
        && validWorkout(request.resource.data)
        && ('provenance' in request.resource.data || id.matches('^[A-Za-z0-9_-]{1,80}$'));
    }
    match /users/{uid}/races/{id} {
      allow create, update: if owner(uid) && identity(request.resource.data, id) && validRace(request.resource.data);
    }
    match /users/{uid}/metrics/{id} {
      allow create, update: if owner(uid) && identity(request.resource.data, id) && validMetric(request.resource.data);
    }
    // Parent profiles, unknown collections and all nested paths are denied.
    match /{document=**} { allow read, write: if false; }
  }
}
