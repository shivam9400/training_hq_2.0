rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function str(v, n) { return v is string && v.size() <= n; }
    function num(v, lo, hi) { return v is number && v >= lo && v <= hi; }
    function optionalNum(v, lo, hi) { return v == null || num(v, lo, hi); }
    function date(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function instant(v) { return v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](\\.[0-9]{1,3})?Z$'); }
    function kind(v) { return v in ['Run', 'Walk', 'Strength', 'Yoga', 'Training', 'Rest', 'Race', 'Other']; }
    function identity(d, id) { return d.id == id && id.matches('^[A-Za-z0-9_-]{1,80}$'); }
    function fields(d, names) { return d.keys().hasAll(names) && d.keys().hasOnly(names); }
    function optionalFields(d, required, optional) { return d.keys().hasAll(required) && d.keys().hasOnly(required.concat(optional)); }
    function hash(v) { return v is string && v.matches('^[a-f0-9]{64}$'); }
    function source(v, session) {
      return v is map && v.keys().hasAll(['sourceId', 'sourceHash', 'version'])
        && v.keys().hasOnly(session ? ['sourceId', 'sourceHash', 'version', 'rowId'] : ['sourceId', 'sourceHash', 'version'])
        && hash(v.sourceId) && hash(v.sourceHash) && v.version is int && v.version == 1
        && (!session || ('rowId' in v && hash(v.rowId)));
    }
    function metadata(d) {
      return (!('slot' in d) || (d.slot is int && num(d.slot, 1, 99)))
        && (!('week' in d) || (d.week is int && num(d.week, 1, 9999)))
        && (!('phase' in d) || str(d.phase, 120))
        && (!('day' in d) || d.day in ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'])
        && (!('importSource' in d) || (d.keys().hasAll(['slot', 'week', 'phase', 'day']) && source(d.importSource, true) && d.id == 'row_' + d.importSource.rowId && d.planId == 'imp_' + d.importSource.sourceId));
    }
    function validPlan(d) {
      return optionalFields(d, ['id', 'title', 'startDate', 'endDate'], ['importSource']) && str(d.title, 120) && d.title.size() > 0 && date(d.startDate) && date(d.endDate) && d.startDate <= d.endDate && (!('importSource' in d) || (source(d.importSource, false) && d.id == 'imp_' + d.importSource.sourceId));
    }
    function validSession(d) {
      return optionalFields(d, ['id', 'planId', 'date', 'type', 'title', 'minutes', 'target', 'instructions', 'status'], ['slot', 'week', 'phase', 'day', 'importSource']) && metadata(d)
        && d.planId is string && d.planId.matches('^[A-Za-z0-9_-]{1,80}$') && date(d.date) && kind(d.type)
        && str(d.title, 120) && d.title.size() > 0 && num(d.minutes, 0, 900)
        && (d.type != 'Run' || d.minutes > 0)
        && str(d.target, 200) && str(d.instructions, 4000) && d.status in ['Planned', 'Done', 'Partial', 'Skipped'];
    }
    function validWorkout(d) {
      return fields(d, ['id', 'title', 'type', 'start', 'end', 'reportedMeters', 'gpsMeters', 'distanceSource', 'qualityFlags', 'source', 'sourceId', 'averageHr'])
        && str(d.title, 120) && d.title.size() > 0 && kind(d.type) && instant(d.start) && instant(d.end) && d.end > d.start
        && optionalNum(d.reportedMeters, 0, 500000) && optionalNum(d.gpsMeters, 0, 500000)
        && d.distanceSource in ['reported', 'gps-validated', 'unavailable']
        && (d.distanceSource != 'reported' || d.reportedMeters != null)
        && (d.distanceSource != 'gps-validated' || (d.gpsMeters != null && d.qualityFlags.hasAny(['gps-validated'])))
        && d.qualityFlags is list && d.qualityFlags.size() <= 10
        && d.qualityFlags.hasOnly(['unvalidated-summary', 'gps-validated', 'gps-unreliable', 'distance-mismatch', 'no-distance'])
        && str(d.source, 80) && d.source.size() > 0 && str(d.sourceId, 200) && d.sourceId.size() > 0 && optionalNum(d.averageHr, 25, 250);
    }
    function validRace(d) {
      return fields(d, ['id', 'title', 'date', 'distanceKm', 'goal']) && str(d.title, 120) && d.title.size() > 0 && date(d.date) && num(d.distanceKm, 0.001, 500) && str(d.goal, 300);
    }
    function validMetric(d) {
      return fields(d, ['id', 'date', 'restingHr', 'hrv', 'sleepHours', 'soreness', 'rpe', 'steps', 'notes'])
        && date(d.date) && d.id == d.date && optionalNum(d.restingHr, 25, 220) && optionalNum(d.hrv, 0, 300)
        && optionalNum(d.sleepHours, 0, 24) && optionalNum(d.soreness, 1, 5) && optionalNum(d.rpe, 1, 10)
        && optionalNum(d.steps, 0, 200000) && str(d.notes, 2000);
    }
    function known(c) { return c in ['plans', 'sessions', 'workouts', 'races', 'metrics']; }
    function valid(c, d) {
      return (c == 'plans' && validPlan(d)) || (c == 'sessions' && validSession(d)) || (c == 'workouts' && validWorkout(d)) || (c == 'races' && validRace(d)) || (c == 'metrics' && validMetric(d));
    }
    match /users/{uid}/{collection}/{id} {
      allow get, delete: if owner(uid) && known(collection);
      allow list: if owner(uid) && known(collection) && request.query.limit != null && request.query.limit <= 200;
      allow create, update: if owner(uid) && known(collection) && identity(request.resource.data, id) && valid(collection, request.resource.data);
    }
    // Parent profiles, unknown collections and all nested paths are denied.
    match /{document=**} { allow read, write: if false; }
  }
}
