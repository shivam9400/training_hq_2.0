{
  "name": "training-hq-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs && node scripts/check-production-isolation.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "test": "vitest run",
    "test:rules": "node scripts/test-rules.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write src e2e scripts drive-diagnostic drive-diagnostic-e2e drive-hosted-e2e drive-codespace-e2e *.ts *.js index.html public/manifest.webmanifest",
    "format:check": "prettier --check src e2e scripts drive-diagnostic drive-diagnostic-e2e drive-hosted-e2e drive-codespace-e2e *.ts *.js index.html public/manifest.webmanifest",
    "dev:drive-test": "vite --config vite.drive-test.config.ts",
    "check:drive-test": "tsc -p tsconfig.drive-test.json",
    "build:drive-test": "npm run check:drive-test && vite build --config vite.drive-test.config.ts",
    "test:drive-browser": "playwright test --config playwright.drive-test.config.ts",
    "build:drive-hosted": "npm run check:drive-test && vite build --config vite.drive-hosted.config.ts",
    "check:drive-hosted-assets": "node scripts/check-drive-hosted-assets.mjs",
    "dev:drive-codespace": "vite --config vite.drive-codespace.config.ts",
    "test:drive-hosted-browser": "playwright test --config playwright.drive-hosted.config.ts",
    "test:drive-codespace-browser": "playwright test --config playwright.drive-codespace.config.ts"
  },
  "dependencies": {
    "@zip.js/zip.js": "2.25.0",
    "fast-xml-parser": "5.12.1",
    "firebase": "13.3.0",
    "fit-file-parser": "6.2.9",
    "papaparse": "5.7.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.36.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "overrides": {
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.7"
    }
  }
}
